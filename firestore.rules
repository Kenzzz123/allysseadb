rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ferdinand262010@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Validation Helpers ---
    
    function isValidUser(data) {
      return (data.keys().hasAll(['username', 'role', 'lastSeen', 'online']) || data.keys().size() <= 6) &&
             (!('username' in data) || (data.username is string && data.username.size() <= 50)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 100)) &&
             (!('role' in data) || (data.role in ['player', 'admin', 'system'])) &&
             (!('createdAt' in data) || (data.createdAt is number)) &&
             (!('lastSeen' in data) || (data.lastSeen is number)) &&
             (!('online' in data) || (data.online is bool));
    }

    function isValidCharacter(data) {
      return (!('name' in data) || (data.name is string && data.name.size() <= 50)) &&
             (!('keywords' in data) || (data.keywords is list && data.keywords.size() <= 20)) &&
             (!('stats' in data) || (data.stats is map && data.stats.keys().hasAll(['level', 'karmaPoint', 'vela', 'totalIncome', 'totalExpense']))) &&
             (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
             (!('createdAt' in data) || (data.createdAt is number)) &&
             (!('updatedAt' in data) || (data.updatedAt is number)) &&
             (!('isSystem' in data) || (data.isSystem is bool)) &&
             (!('pin' in data) || (data.pin == null || (data.pin is string && data.pin.size() == 4)));
    }

    function isValidLog(data) {
      return (data.keys().hasAll(['charId', 'userId', 'action', 'timestamp']) || data.keys().hasAll(['action', 'timestamp', 'userId'])) &&
             (!('charId' in data) || (data.charId is string)) &&
             (!('userId' in data) || (data.userId is string)) &&
             (!('action' in data) || (data.action is string)) && 
             (!('timestamp' in data) || (data.timestamp is number));
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['senderCharId', 'senderCharName', 'senderUserId', 'recipientCharId', 'recipientCharName', 'recipientUserId', 'amount', 'reason', 'timestamp']) &&
             data.amount is number;
    }

    // --- Collection Matches ---

    // Users
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().keys().hasAll(['username', 'email', 'role', 'createdAt', 'lastSeen', 'online']) &&
                    (incoming().role == 'player' || request.auth.token.email == 'ferdinand262010@gmail.com');
      allow update: if (isOwner(userId) || isAdmin()) && isValidUser(incoming()) && (
        // Action: Update profile/online status
        (incoming().diff(existing()).affectedKeys().hasOnly(['username', 'lastSeen', 'online', 'role']) &&
         (incoming().get('role', existing().role) == existing().role || isAdmin()))
      );
      allow delete: if isAdmin();
    }

    // Characters
    match /characters/{charId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidCharacter(incoming()) && 
                    incoming().keys().hasAll(['userId', 'name', 'stats', 'createdAt', 'updatedAt', 'keywords']) &&
                    incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidCharacter(incoming()) && (
        isAdmin() || 
        (existing().userId == request.auth.uid && incoming().get('userId', request.auth.uid) == request.auth.uid && (
          // Action: Rename or update pin
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'pin', 'updatedAt', 'keywords']) ||
          // Action: Update stats
          incoming().diff(existing()).affectedKeys().hasOnly(['stats', 'updatedAt'])
        )) ||
        // Action: Global transfer (updates recipient)
        (incoming().diff(existing()).affectedKeys().hasOnly(['stats', 'updatedAt', 'lastSeen']) && 
         incoming().get('userId', existing().userId) == existing().userId)
      );
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    // Logs
    match /logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidLog(incoming());
      allow delete: if isAdmin();
    }

    // Transactions
    match /transactions/{transactionId} {
      allow read: if isAdmin() || (isSignedIn() && (resource.data.senderUserId == request.auth.uid || resource.data.recipientUserId == request.auth.uid));
      allow create: if isSignedIn() && isValidTransaction(incoming()) && incoming().senderUserId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // System Collection (Leaderboards, etc)
    match /system/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Banned Emails
    match /banned_emails/{email} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Admin Warnings
    match /admin_warnings/{warningId} {
      allow read: if isAdmin();
      allow create: if isSignedIn(); // Users can trigger warnings via app logic
      allow delete: if isAdmin();
    }
  }
}
