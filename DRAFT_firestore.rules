rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'ferdinand262010@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Validation Helpers ---
    
    function isValidUser(data) {
      return data.keys().hasAll(['username', 'email', 'role', 'createdAt', 'lastSeen', 'online']) &&
             data.keys().size() >= 6 &&
             data.username is string && data.username.size() <= 50 &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['player', 'admin', 'system'] &&
             data.createdAt is number &&
             data.lastSeen is number &&
             data.online is bool;
    }

    function isValidCharacter(data) {
      return data.keys().hasAll(['userId', 'name', 'stats', 'createdAt', 'updatedAt']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.name is string && data.name.size() <= 50 &&
             data.stats is map &&
             data.stats.keys().hasAll(['level', 'hp', 'attack', 'defense', 'gold', 'experience']) &&
             data.createdAt is number &&
             data.updatedAt is number;
    }

    function isValidLog(data) {
      return data.keys().hasAll(['charId', 'userId', 'action', 'timestamp']) &&
             data.charId is string && data.userId is string &&
             data.action is string && data.timestamp is number;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['senderCharId', 'senderCharName', 'senderUserId', 'recipientCharId', 'recipientCharName', 'recipientUserId', 'amount', 'reason', 'timestamp']) &&
             data.amount is number && data.amount > 0;
    }

    // --- Collection Matches ---

    // Users
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming()) && 
                    (incoming().role == 'player' || request.auth.token.email == 'ferdinand262010@gmail.com');
      allow update: if (isOwner(userId) || isAdmin()) && (
        // Action: Update profile/online status
        (incoming().diff(existing()).affectedKeys().hasOnly(['username', 'lastSeen', 'online', 'role']) &&
         (incoming().role == existing().role || isAdmin()))
      );
      allow delete: if isAdmin();
    }

    // Characters
    match /characters/{charId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidCharacter(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin() || 
        (existing().userId == request.auth.uid && incoming().userId == request.auth.uid && (
          // Action: Rename or update pin
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'pin', 'updatedAt']) ||
          // Action: Update stats
          incoming().diff(existing()).affectedKeys().hasOnly(['stats', 'updatedAt'])
        )) ||
        // Action: Global transfer (updates recipient)
        (incoming().diff(existing()).affectedKeys().hasOnly(['stats', 'updatedAt', 'lastSeen']) && 
         incoming().userId == existing().userId)
      );
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    // Logs
    match /logs/{logId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidLog(incoming());
      allow delete: if isAdmin();
    }

    // Transactions
    match /transactions/{transactionId} {
      allow read: if isAdmin() || (isSignedIn() && (resource.data.senderUserId == request.auth.uid || resource.data.recipientUserId == request.auth.uid));
      allow create: if isSignedIn() && isValidTransaction(incoming()) && incoming().senderUserId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Banned Emails
    match /banned_emails/{email} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Admin Warnings
    match /admin_warnings/{warningId} {
      allow read: if isAdmin();
      allow create: if isSignedIn(); // Users can trigger warnings via app logic
      allow delete: if isAdmin();
    }
  }
}
